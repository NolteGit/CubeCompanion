{
  "name": "cubecompanion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run lint && node -e \"console.log('\\x1b[32m✓ GREEN — verification passed\\x1b[0m')\"",
    "cube:extract": "tsx scripts/cube/extract.ts",
    "cube:resolve": "tsx scripts/cube/resolve.ts",
    "cube:validate": "tsx scripts/cube/validate.ts",
    "cube:release": "tsx scripts/cube/release.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15"
  },
  "volta": {
    "node": "24.15.0",
    "npm": "12.0.2"
  }
}
